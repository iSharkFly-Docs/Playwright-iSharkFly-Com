{
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.17",
    "vue": "^3.5.38",
    "wrangler": "^4.164.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "i18n:sync": "node scripts/sync-zh.mjs",
    "docs:dev": "node scripts/sync-zh.mjs && vitepress dev",
    "docs:build": "node scripts/sync-zh.mjs && node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js build",
    "docs:preview": "vitepress preview"
  }
}
